---
import LogoMark from './LogoMark.astro';
import { site } from '../site';
interface Props { currentPath?: string; }
const { currentPath = '/' } = Astro.props;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---
<header id="site-header" class="site-header-wrap">
  <div class="site-header__inner">
    <div class="site-brand">
      <LogoMark />
      <a class="site-brand__title" href="/" title={site.title}>{site.shortTitle}</a>
    </div>
    <div class="header-actions">
      <button id="openMenu" class="menu-button" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="site-menu"><span class="menu-button__line"></span><span class="menu-button__line"></span></button>
      <nav id="site-menu" class="site-menu" aria-label="主导航" aria-hidden="false">
        {site.nav.map((item) => <a class:list={{ active: isActive(item.href) }} href={item.href} title={item.label}>{item.label}</a>)}
      </nav>
    </div>
    <button id="darkToggle" class="theme-toggle" type="button" aria-label="切换主题">
      <span class="theme-toggle__horizon" aria-hidden="true">
        <span class="theme-toggle__sun">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2"/>
            <path d="M12 20v2"/>
            <path d="M2 12h2"/>
            <path d="M20 12h2"/>
            <path d="m4.93 4.93 1.41 1.41"/>
            <path d="m17.66 17.66 1.41 1.41"/>
            <path d="m19.07 4.93-1.41 1.41"/>
            <path d="m6.34 17.66-1.41 1.41"/>
          </svg>
        </span>
        <span class="theme-toggle__moon">
          <svg viewBox="0 0 24 24">
            <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a7 7 0 1 0 10.7 10.7Z"/>
          </svg>
        </span>
      </span>
      <span class="sr-only">切换主题</span>
    </button>
  </div>
</header>
