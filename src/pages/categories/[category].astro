---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../theme/components/PostCard.astro';
import { getAllCategories, getCategorySlug, getPostCategory, getPublishedPosts } from '../../lib/posts';
export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getAllCategories(posts).map(({ category }) => ({ params: { category: getCategorySlug(category) }, props: { category } }));
}
const posts = await getPublishedPosts();
const { category } = Astro.props;
const filtered = posts.filter((post) => getPostCategory(post) === category);
---
<BaseLayout title={category} description={'分类 ' + category + ' 下的文章。'}>
  <div class="page-shell">
    <section class="page-hero">
      <p class="eyebrow">Category</p>
      <h1>{category}</h1>
      <p>这个分类下共有 {filtered.length} 篇文章。</p>
    </section>
    <section class="post-list page-list" aria-label={'分类 ' + category + ' 的文章'}>
      {filtered.length > 0
        ? filtered.map((post) => <PostCard post={post}/>)
        : <p class="empty-note">这个分类下还没有已发布文章。给文章补充 title、pubDate，并确保 draft 不是 true 后会显示在这里。</p>}
    </section>
  </div>
</BaseLayout>
