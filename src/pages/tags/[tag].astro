---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../theme/components/PostCard.astro';
import { getAllTags, getPublishedPosts } from '../../lib/posts';
export async function getStaticPaths() { const posts = await getPublishedPosts(); return getAllTags(posts).map(({ tag }) => ({ params: { tag: encodeURIComponent(tag) }, props: { tag } })); }
const posts = await getPublishedPosts();
const { tag } = Astro.props;
const filtered = posts.filter((post) => post.data.tags.includes(tag));
---
<BaseLayout title={`#${tag}`} description={`标签 ${tag} 下的文章。`}>
  <div class="page-shell">
    <section class="page-hero">
      <p class="eyebrow">Tag</p>
      <h1>#{tag}</h1>
      <p>这个标签下共有 {filtered.length} 篇文章。</p>
    </section>
    <section class="post-list page-list" aria-label={`标签 ${tag} 的文章`}>
      {filtered.map((post) => <PostCard post={post}/>)}</section>
  </div>
</BaseLayout>
