---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPublishedPosts, getTagPath } from '../../lib/posts';
const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---
<BaseLayout title="标签" description="按 Astro、Obsidian、Markdown、前端工程和 AI 工具等标签浏览技术文章。">
  <div class="page-shell">
    <section class="page-hero">
      <p class="eyebrow">Tags</p>
      <h1>标签</h1>
      <p>按主题快速找到相关文章。</p>
    </section>
    <section class="tag-cloud page-list" aria-label="标签列表">
      {tags.map(({ tag, count }) => <a class="tag tag--link" href={getTagPath(tag)}>{tag}<span>{count}</span></a>)}
    </section>
  </div>
</BaseLayout>
